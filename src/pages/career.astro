---
import Layout from '../layouts/Layout.astro';

const response = await fetch('https://api.github.com/users/kanakmk/repos?sort=pushed&per_page=3');
const repos = await response.json();

const skills = [
	{
		category: 'Languages & Frameworks',
		items: ['Java', 'Angular', 'TypeScript / JavaScript', 'C++', 'Python', 'SQL'],
	},
	{
		category: 'Tools & Platforms',
		items: ['AI Agents', '- Claude, Copilot, Cursor','Git', 'AWS', 'IntelliJ', 'VSCode', 'CSP'],
	},
	{
		category: 'Design & Creative',
		items: ['Illustration', 'UI/UX', 'Branding', 'Merchandise Design', 'Digital Art'],
	}
];

const experience = [
	{
		role: '[Role Title]',
		org: '[Company Name]',
		period: '[Start] – [End]',
		description: '[A short summary of what you did in this role.]',
	},
	{
		role: '[Role Title]',
		org: '[Company Name]',
		period: '[Start] – [End]',
		description: '[A short summary of what you did in this role.]',
	},
	{
		role: '[Role Title]',
		org: '[Company Name]',
		period: '[Start] – [End]',
		description: '[A short summary of what you did in this role.]',
	},
];
---

<Layout>
	<main class="flex-1 min-h-0 w-full px-6 main-banner career-scroll">
		<section class="career-section flex flex-col items-center justify-center">
			<h1 class="text-4xl md:text-6xl main-text pb-10 top-fade">Projects</h1>
			<div class="grid grid-cols-3 gap-4 md:gap-6 w-full h-90 md:w-3/4 top-fade">
				{
					repos.map((repo: { name: unknown; description: any; html_url: string | URL | null | undefined; }) => (
						<div class="career-card portfolio-card grid grid-rows-3 text-center">
							<h3 class="sub-text text-xl self-end">{repo.name}</h3>
							<p class="main-text self-center">{repo.description ?? 'No description provided'}</p>
							<a class="main-text self-end" href={repo.html_url} target="_blank" rel="noopener">View on GitHub →</a>
						</div>
					))
				}
			</div>
		</section>

		<section class="career-section flex flex-col items-center justify-center">
			<h1 class="text-4xl md:text-6xl main-text pb-10 top-fade">Skills</h1>
			<div class="flex flex-col md:flex-row gap-6 w-full md:w-3/4 justify-center top-fade">
				{
					skills.map((group) => (
						<div class="career-card flex flex-col gap-3 w-full md:w-1/3">
							<h2 class="sub-text text-xl">{group.category}</h2>
							<ul class="main-text list-none flex flex-col gap-1">
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="career-section flex flex-col items-center justify-center">
			<h1 class="text-4xl md:text-6xl main-text pb-10 top-fade">Experience</h1>
			<div class="flex flex-col gap-6 w-full md:w-2/3 top-fade">
				{
					experience.map((job) => (
						<div class="career-card flex flex-col gap-1">
							<h2 class="sub-text text-xl">{job.role} · {job.org}</h2>
							<span class="main-text text-sm opacity-80">{job.period}</span>
							<p class="main-text">{job.description}</p>
						</div>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<style>
	.career-scroll {
		height: 100%;
		overflow-y: auto;
		scroll-snap-type: y mandatory;
	}

	.career-section {
		height: 100%;
		width: 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}

	.career-card {
		padding: 1.25rem;
		border-radius: 0 0.75rem;
		outline: 2px solid #eeae35;
		outline-offset: 4px;
	}

	.portfolio-card {
		aspect-ratio: 3 / 4;
		transition: transform 0.3s ease;
	}

	.portfolio-card:hover {
		transform: scale(1.06);
	}
</style>
