---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout>
    <main class="flex-1 flex flex-col items-center justify-center w-full px-6 main-banner">

		<div class="flex items-center py-6 justify-center top-fade">
            <img src={`${base}/images/buncatsleep.png`} alt="bun & cat sleeping"/>
		</div>

		<div class="flex flex-col text-center top-fade">
			<h2 class="text-2xl main-text pb-2">one thing about me is that...</h2>
			<h2 class="text-2xl sub-text">I love being</h2>
			<br/>
			<h1 id="word-carousel" class="text-5xl md:text-8xl dynamic-font w-full md:w-150 h-16 md:h-25 bottom-fade">Creative</h1>
			<br/> <br/>
			<h4 class="main-text text-xl">. ݁˖ .⋆ ݁｡ whether it's in an ide or in a sketchbook ｡⋆. ݁˖ .</h4>
		</div>

		<div class="min-h-dvh flex flex-col items-center">
			<div class="flex flex-col justify-center w-full md:w-1/2 mx-auto gap-6 my-10">
				<div class="flex flex-col md:flex-row gap-6 p-4 left-fade-delay">
					<p class="main-text w-full md:w-1/2 text-lg md:pl-16">
						As a creative in the fields of both
						tech and art, I've always been curious
						of both worlds!
						<br /><br />
						With 3 years of experience in full-stack
						software development and lifelong
						experience of being an artist, I've always
						sought to incorporate both into my lifestyle...
					</p>
					<img
						src={`${base}/gifs/bungif.gif`}
						alt="bun blink"
						class="w-full md:w-1/2 h-48 md:h-64 object-contain"
					/>
				</div>
				<div class="flex flex-col md:flex-row gap-6 p-4 right-fade-delay">
					<img
						src={`${base}/gifs/catgif.gif`}
						alt="cat blep"
						class="w-full md:w-1/2 h-48 md:h-64 object-contain"
					/>
					<p class="main-text w-full md:w-1/2 text-lg md:pr-16">
						So, I built a brand around the kind of aesthetics
						I've always been naturally drawn to
						<br /><br />
						then a community - to share that vision
						with others all around the world
						<br /><br />
						and finally, a couple of passion projects to showcase my journey!
					</p>
				</div>
			</div>

			<button class="nav-button m-4">
				<a href={`${base}/career`}>here's what I've built! →</a>
			</button>

		</div>
	</main>
</Layout>

<script>
	// create the carousel effect for multiple words in different fonts
	const items = [
		{ word: 'Creative', font: '"Dancing Script", cursive' },
		{ word: 'Unique', font: '"Homemade Apple", cursive' },
		{ word: 'Original', font: '"Irish Grover", cursive' },
		{ word: 'Artistic', font: '"Londrina Sketch", sans-serif' },
		{ word: 'Imaginative', font: '"Mr De Haviland", cursive' },
	];

	const INTERVAL_MS = 1200;
	const el = document.getElementById('word-carousel');

	if (el) {
		let i = 0;
		let intervalId: ReturnType<typeof setInterval> | null = null;

		function tick() {
			const { word, font } = items[i % items.length];
			el!.textContent = word;
			el!.style.fontFamily = font;
			i++;
		}

		function toggleLoop() {
			if (intervalId) {
				clearInterval(intervalId);
				intervalId = null;
			} else {
				intervalId = setInterval(tick, INTERVAL_MS);
			}
		}

		el.addEventListener('click', toggleLoop);

		// load fonts before they appear (prevents glitching)
		const fontLoadPromises = items.map((item) =>
			document.fonts.load(`1em ${item.font}`)
		);

		Promise.all(fontLoadPromises).then(() => {
			toggleLoop();
		});
	}
</script>

<style>
	.dynamic-font {
		font-family: "Dancing Script", cursive;
		color: #eeae35
	}

	.dynamic-font:hover {
		color: #ccd347;
		transition: color 0.4s ease;
	}

	#word-carousel {
		cursor: pointer;
	}
</style>
