		<div class="flex items-center justify-center">
            <img src={`${base}/images/buncatsleep.png`} alt="bun & cat sleeping"/>
		</div>

        <div class="flex flex-row gap-15 min-w-[320px] py-10 main-text">
			hi
		</div>
	</main>
</Layout>
