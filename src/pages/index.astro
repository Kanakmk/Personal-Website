---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout>
	<main class="flex-1 flex flex-col items-center justify-center w-full main-banner">
		<div class="flex flex-col md:flex-row items-center gap-6 md:gap-15 px-6 py-4 md:py-6 lg:py-8 xl:py-10 main-text left-fade">
			<div class="hidden md:flex flex-col gap-4 md:-mr-30">
                <pre class="text-4xl mt-auto pb-10">⋆ <br/> ✦</pre>
            </div>
			<div class="flex flex-col items-center">
				<h1 class="home-heading text-6xl md:text-9xl pr-8">Hello !</h1>
                <h2 class="author-heading text-2xl md:text-3xl">I'm Kanak ~ </h2>
				<p class="home-text pt-6 home-item-1">software dev</p>
				<p class="home-text pt-6 -mt-7 home-item-2">illustrator</p>
                <p class="home-text pt-6 -mt-7 home-item-3">small business owner</p>
			</div>
			<div>
				<img src={`${base}/images/p1.jpg`} alt="Personal Portrait" class="rounded-3xl w-56 h-60 md:w-70 md:h-75 object-cover"/>
			</div>
		</div>

		<div class="flex flex-col items-center px-6 py-4 md:py-6 lg:py-8 xl:py-10 left-fade">
            <button class="nav-button">
                <a href={`${base}/about`}>more about me →</a>
            </button>
            <br/>
            <!-- <img src={`${base}/images/buncatsleep.png`} alt="bun & cat sleeping"/> -->
		</div>
	</main>
</Layout>



<style>
	.home-heading {
		font-family: "Fleur De Leah", cursive;
        font-weight: 400;
        font-style: normal;
        align-self: flex-start;
	}

    .author-heading {
        font-family: "Autour One", system-ui;
        font-weight: 400;
        font-style: normal;
        align-self: flex-end;
    }

    .home-text {
        font-family: "Quicksand", sans-serif;
        font-weight: 400;
        font-style: normal;
        align-self: flex-end;
        text-align: right;
        font-size: 1.4rem;
        color: #eeae35
    }

</style>
